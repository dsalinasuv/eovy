NODE_ENV=production
# Dominio público de la web y de la aplicación (sin barra final). No se fija en el código.
SITE_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3006
# Contacto: la web envía por SMTP y no guarda nada.
CONTACT_TO=hello@ecoailab.es
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
# starttls | ssl | none (none solo en desarrollo)
SMTP_SECURITY=starttls
SMTP_USER=usuario_smtp
SMTP_PASSWORD=clave_smtp
SMTP_FROM=hello@ecoailab.es
